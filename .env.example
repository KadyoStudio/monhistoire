# Base de données — Neon, région européenne obligatoire (RGPD).
# À fixer avant la première migration, pas après.
DATABASE_URL=

# Better Auth. Générer le secret avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Envoi des liens de connexion (Resend). Sans clé, le lien est écrit dans la
# console en développement ; en production, l'absence est une erreur franche.
# EMAIL_FROM exige un domaine vérifié chez Resend. Sans domaine, laissez la
# valeur par défaut : elle n'envoie que vers votre propre adresse.
RESEND_API_KEY=
EMAIL_FROM=

# Stockage audio — Vercel Blob, région européenne.
BLOB_READ_WRITE_TOKEN=

# Transcription et amélioration de la lecture.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Observabilité. Régions européennes : ingest.de.sentry.io, eu.i.posthog.com.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Paiement (phase 10) — Stripe en paiement unique, jamais d'abonnement.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
